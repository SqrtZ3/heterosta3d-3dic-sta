/*
 * asap7_ff_placeholder.lib  --  PLACEHOLDER Liberty for the BOTTOM die (FF corner)
 *
 *  This is NOT a real timing library.  It exists so the example commands and
 *  the Makefile are self-consistent when building against the CPU stub (which
 *  does not parse .lib files).  For graded runs, REPLACE the --bot-lib path
 *  with a real Fast-Fast ASAP7 (or Sky130) .lib -- see pdk/README.md.
 *
 *  Heterogeneous requirement: BOTTOM die = Fast-Fast (best-case fast) corner.
 */
library (asap7_ff_placeholder) {
  technology (cmos);
  delay_model : table_lookup;
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1, ff);
  nom_process : 1.0;
  nom_voltage : 0.77;   /* FF: high voltage */
  nom_temperature : 0.0;    /* FF: low temperature */
  /* cell () { ... } definitions go here in the real library */
}
